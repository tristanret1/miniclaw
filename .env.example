# Required
DISCORD_BOT_TOKEN=your-discord-bot-token

# Provider — "anthropic" (Claude) or "codex" (OpenAI ChatGPT subscription)
PROVIDER=anthropic

# LLM — Anthropic
CLAUDE_MODEL=claude-sonnet-4-20250514   # or claude-haiku-4-5, etc.

# LLM — Codex (when PROVIDER=codex)
# CODEX_MODEL=gpt-5.3-codex             # gpt-5.1-codex, gpt-5.2-codex, etc.

MAX_HISTORY=20                          # max conversation turns kept in context
TOOLS_ENABLED=true                      # enable tool use (exec, memory, claude_code)

# Optional — GitHub (for gh CLI / git push in exec tool)
# GITHUB_TOKEN=github_pat_xxx

# Optional — PostgreSQL (Neon) — when set, all storage uses PostgreSQL instead of SQLite
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-1.neon.tech/miniclaw?sslmode=require

# Optional — embeddings (enables hybrid vector+BM25 memory search)
# OPENAI_API_KEY=sk-xxx

# Optional — Claude Code integration
# ACP_CWD=/path/to/project             # default working directory for claude_code tool

# Optional — Twilio (phone_call tool: TTS voice calls)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+14155551234

# Optional — SMS gateway (Twilio inbound webhook)
    # SMS_ENABLED=false
    # SMS_WEBHOOK_PORT=8080
    # SMS_WEBHOOK_URL=https://market-yes-spotlight-soldier.trycloudflare.com    # public URL for signature validation
    
# Optional — iMessage gateway (requires macOS + imsg CLI)
# IMESSAGE_ENABLED=false
# IMESSAGE_CLI_PATH=imsg                 # path to imsg binary
# IMESSAGE_DB_PATH=                      # path to Messages/chat.db (optional, auto-detected)
# IMESSAGE_ALLOW_FROM=+14155551234,user@icloud.com  # allowlist (empty = allow all)
# IMESSAGE_SERVICE=auto                  # "imessage", "sms", or "auto"

# DM whitelist — only these Discord user IDs can DM the bot (empty = deny all DMs)
# ALLOWED_DM_USERS=123456789,987654321

# Optional — auto-reply in guild channels
# AUTO_REPLY_ENABLED=false
# AUTO_REPLY_CHANNELS=123456789,987654321
# AUTO_REPLY_CHANCE=0.1                 # 0.0-1.0
# AUTO_REPLY_KEYWORDS=keyword1,keyword2

# Optional — Heartbeat (periodic background checks)
# HEARTBEAT_ENABLED=false
# HEARTBEAT_INTERVAL=30m                # e.g. "30m", "1h", "2h30m"
# HEARTBEAT_CHANNEL_ID=123456789        # Discord channel for heartbeat delivery
# HEARTBEAT_ACTIVE_START=09:00          # HH:MM (24h), inclusive — empty = no restriction
# HEARTBEAT_ACTIVE_END=22:00            # HH:MM (24h), exclusive
# HEARTBEAT_ACTIVE_TZ=America/Vancouver # IANA timezone (empty = local)
# HEARTBEAT_ACK_MAX_CHARS=300           # max chars to still count as "ack" (skip delivery)
# HEARTBEAT_ISOLATED=true               # use isolated session per heartbeat run

# Optional — Google Calendar integration
# GOOGLE_CALENDAR_ENABLED=false
# GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret
# GOOGLE_CALENDAR_LIFE_ID=your-life-calendar@gmail.com       # personal calendar (read-write)
# GOOGLE_CALENDAR_WORK_ID=your-work-calendar@gmail.com       # work calendar (read-only)

# Optional — Voice gateway (local microphone, macOS)
# VOICE_ENABLED=false
# WAKE_WORDS=miniclaw,小爪              # comma-separated wake words
# TTS_PROVIDER=openai                   # "openai" or "edge"
# TTS_VOICE=alloy                       # OpenAI voice: alloy, echo, fable, onyx, nova, shimmer
# TTS_MODEL=gpt-4o-mini-tts            # OpenAI TTS model
# STT_MODEL=whisper-1                   # OpenAI Whisper model
# VOICE_SILENCE_THRESHOLD=500           # RMS silence threshold (0-32767)
# VOICE_SILENCE_DURATION=1.5            # seconds of silence to split utterance
# VOICE_SAMPLE_RATE=16000               # audio sample rate in Hz

# Multi-agent mode — configure agents via agents.json (not .env)
# Each agent supports "enabled": true/false to skip at startup.
# Use --only to start specific agents:
#   python main.py --only default
#   python main.py --only default,Kokiri
# Use the CLI to manage agents:
#   python main.py agents list
#   python main.py agents add
#   python main.py agents remove <name>
#   python main.py agents edit <name>
#   python main.py agents show <name>
#   python main.py agents migrate          # migrate from .env to agents.json
# Or directly: python scripts/agent_cli.py <command>
