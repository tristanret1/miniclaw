# Required
DISCORD_BOT_TOKEN=your-discord-bot-token

# Provider — "anthropic" (Claude) or "codex" (OpenAI ChatGPT subscription)
PROVIDER=anthropic

# LLM — Anthropic
CLAUDE_MODEL=claude-sonnet-4-20250514   # or claude-haiku-4-5, etc.

# LLM — Codex (when PROVIDER=codex)
# CODEX_MODEL=gpt-5.3-codex             # gpt-5.1-codex, gpt-5.2-codex, etc.

MAX_HISTORY=20                          # max conversation turns kept in context
TOOLS_ENABLED=true                      # enable tool use (exec, memory, claude_code)

# Optional — GitHub (for gh CLI / git push in exec tool)
# GITHUB_TOKEN=github_pat_xxx

# Optional — embeddings (enables hybrid vector+BM25 memory search)
# OPENAI_API_KEY=sk-xxx

# Optional — Claude Code integration
# ACP_CWD=/path/to/project             # default working directory for claude_code tool

# Optional — Twilio (phone_call tool: TTS voice calls)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+14155551234

# Optional — SMS gateway (Twilio inbound webhook)
    # SMS_ENABLED=false
    # SMS_WEBHOOK_PORT=8080
    # SMS_WEBHOOK_URL=https://market-yes-spotlight-soldier.trycloudflare.com    # public URL for signature validation
    
# Optional — iMessage gateway (requires macOS + imsg CLI)
# IMESSAGE_ENABLED=false
# IMESSAGE_CLI_PATH=imsg                 # path to imsg binary
# IMESSAGE_DB_PATH=                      # path to Messages/chat.db (optional, auto-detected)
# IMESSAGE_ALLOW_FROM=+14155551234,user@icloud.com  # allowlist (empty = allow all)
# IMESSAGE_SERVICE=auto                  # "imessage", "sms", or "auto"

# Optional — auto-reply in guild channels
# AUTO_REPLY_ENABLED=false
# AUTO_REPLY_CHANNELS=123456789,987654321
# AUTO_REPLY_CHANCE=0.1                 # 0.0-1.0
# AUTO_REPLY_KEYWORDS=keyword1,keyword2
