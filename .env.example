# ── Secrets only ─────────────────────────────────────────────────────────────
# All non-sensitive settings live in config.yaml at the project root.
# Only put secrets here that should NOT be committed to version control.

# Required
DISCORD_BOT_TOKEN=your-discord-bot-token

# Optional — PostgreSQL (Neon) — when set, all storage uses PostgreSQL instead of SQLite
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-1.neon.tech/miniclaw?sslmode=require

# Optional — embeddings (enables hybrid vector+BM25 memory search)
# OPENAI_API_KEY=sk-xxx

# Optional — GitHub (for gh CLI / git push in exec tool)
# GITHUB_TOKEN=github_pat_xxx

# Optional — Claude Code integration
# ACP_CWD=/path/to/project

# Optional — Twilio (phone_call tool + SMS gateway)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+14155551234

# Optional — Volcengine TTS (豆包语音) API key
# VOLCENGINE_TTS_API_KEY=

# Optional — Google Calendar OAuth credentials
# GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret
# GOOGLE_CALENDAR_LIFE_ID=your-life-calendar@gmail.com
# GOOGLE_CALENDAR_WORK_ID=your-work-calendar@gmail.com

# Optional — Feishu (飞书) bot gateway
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# Optional — GetXAPI (Twitter/X data fetching)
# GETXAPI_TOKEN=get-x-api-xxx

# Optional — GLM (智谱AI) API key
# GLM_API_KEY=xxx

# Optional — MiniMax API key
# MINIMAX_API_KEY=xxx

# Optional — Kimi Code subscription API key (https://www.kimi.com/code/en)
# Note: this is NOT the Moonshot Open Platform key — Kimi Code speaks
# the Anthropic Messages API at https://api.kimi.com/coding/v1/messages
# KIMI_API_KEY=xxx

# Browser backend selection
# BROWSER_BACKEND=crawl4ai   # use crawl4ai for fetch/screenshot/text (stateless)
#                             # omit or set empty to use Playwright (interactive)
